          "metadata": {
            "operationMetadataId": "48534e70-eed0-4e00-b3c9-246258cd719b"
          },
          "type": "Compose",
          "inputs": "@decodeUriComponent(last(split(trim(triggerBody()?['text_1']),'/')))"
